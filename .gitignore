migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local secrets
/lib/core/env.dart

# Release signing -- the keystore and its passwords. Losing this file
# means never being able to publish an update to the same Play Store
# listing again, so it must never be committed; back it up somewhere
# safe outside this repo (a password manager, encrypted drive, etc).
/android/key.properties
/android/app/upload-keystore.jks

# Firebase config for push notifications (wave 4.2) -- identifies the
# Firebase project; download from Firebase Console -> Project settings ->
# your Android app -> google-services.json.
/android/app/google-services.json

# Supabase CLI's local cache/version marker, not project state.
/supabase/.temp/
